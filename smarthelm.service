[Unit]
Description=SmartHelm Drowsiness Detection
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/vyrrs/HelmNet/smarthelm/backend
ExecStart=/home/vyrrs/smarthelm-venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
